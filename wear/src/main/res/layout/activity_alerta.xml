<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/box_inset_layout_padding"
    tools:ignore="MissingClass">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="12dp">

            <!-- Ícono de Alerta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="48sp"
                android:layout_marginBottom="8dp"/>

            <!-- Título Alerta -->
            <TextView
                android:id="@+id/titleAlerta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Alerta!"
                android:textColor="#FF0000"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Mensaje de alerta -->
            <TextView
                android:id="@+id/messageAlerta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Humedad crítica"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <!-- Detalle de parcela -->
            <TextView
                android:id="@+id/detailAlerta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parcela 7 - Cabernet"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Botón Activar Riego (visible inicialmente) -->
            <Button
                android:id="@+id/btnActivarRiego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVAR RIEGO"
                android:backgroundTint="#FF0000"
                android:textColor="@android:color/white"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"/>

            <!-- Layout de Riego Activado (oculto inicialmente) -->
            <LinearLayout
                android:id="@+id/layoutRiegoActivado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅"
                    android:textSize="32sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/titleRiegoActivado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Riego activado!"
                    android:textColor="#4CAF50"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/detailRiegoActivado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parcela 7 - Cabernet"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/duracionRiego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duración: 20 min"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/estimadoRiego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="320 L estimados"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>